#!/usr/bin/env bash

# Gpiano 后端本地配置示例。
# 复制为 scripts/backend.local.sh 后修改；该文件会被 Git 忽略。

# ==================== Python 运行环境 ====================

PYTHON_BIN="python3"

# ==================== Audiveris / OMR 服务 ====================

# 留空时优先使用仓库本地安装，其次查找 PATH 和 /opt/audiveris。
AUDIVERIS_BIN=""

# 缺少 Audiveris 时，是否下载并解压官方 5.11.0 Ubuntu 24.04 安装包。
AUTO_INSTALL_AUDIVERIS="true"
AUDIVERIS_VERSION="5.11.0"
AUDIVERIS_PACKAGE_URL="https://github.com/Audiveris/audiveris/releases/download/5.11.0/Audiveris-5.11.0-ubuntu24.04-x86_64.deb"
AUDIVERIS_PACKAGE_SHA256="f20113aaa33b3149ec8d6a09b2a7963360e65fafd92d69389987a85bbc3ec7a3"

GPIANO_OMR_HOST="127.0.0.1"
GPIANO_OMR_PORT="8765"
GPIANO_OMR_TOKEN="请替换为随机长令牌"
GPIANO_OMR_WORKERS="1"
GPIANO_OMR_TIMEOUT="900"

# ==================== DeepSeek / AI 服务 ====================

# 当前 practice-ai-service 使用 OpenAI Chat Completions 格式。
DEEPSEEK_OPENAI_BASE_URL="https://api.deepseek.com"

# 该地址仅留作切换协议时参考；当前启动器不会使用 Anthropic 格式。
DEEPSEEK_ANTHROPIC_BASE_URL="https://api.deepseek.com/anthropic"

# 可选 deepseek-v4-flash 或 deepseek-v4-pro。
GPIANO_MODEL_NAME="deepseek-v4-flash"
GPIANO_MODEL_API_KEY="请填写新申请或已轮换的 DeepSeek API Key"
GPIANO_MODEL_TIMEOUT="90"

GPIANO_AI_HOST="127.0.0.1"
GPIANO_AI_PORT="8766"
GPIANO_AI_SERVICE_TOKEN="请替换为随机长令牌"

# ==================== Android 真机连接 ====================

# 为 true 时，如果检测到一台 Android 设备，会自动映射 8765 和 8766 端口。
ENABLE_ADB_REVERSE="true"
